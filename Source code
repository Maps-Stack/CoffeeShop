--hourly bucket with times of day
  SELECT  DATE_TRUNC('hour', transaction_time) AS hour_bucket,
  CASE 
    WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 6 AND 11 THEN 'Morning'
    WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 12 AND 16 THEN 'Afternoon'
    WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 17 AND 20 THEN 'Evening'
    ELSE 'Night'
  END AS time_of_day,
  sum(unit_price * transaction_qty) AS hourly_sales
FROM bright_coffee_shop.coffee_shop.coffee_shop_sales
GROUP BY hour_bucket, time_of_day
ORDER BY hourly_sales DESC;

CREATE MATERIALIZED VIEW hourly_bucket AS 
SELECT 
  DATE_TRUNC('HOUR', transaction_time) AS hour_bucket,
  CASE 
    WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 6 AND 11 THEN 'Morning'
    WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 12 AND 16 THEN 'Afternoon'
    WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 17 AND 20 THEN 'Evening'
    ELSE 'Night'
  END AS time_of_day,
  sum(unit_price * transaction_qty) AS hourly_sales
FROM bright_coffee_shop.coffee_shop.coffee_shop_sales
GROUP BY hour_bucket, time_of_day
ORDER BY hourly_sales DESC;



 
CREATE OR REPLACE TABLE hourly_bucket AS 

SELECT 

  DATE_TRUNC('HOUR', transaction_time) AS hour_bucket,

  CASE 

    WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 6 AND 11 THEN 'Morning'

    WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 12 AND 16 THEN 'Afternoon'

    WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 17 AND 20 THEN 'Evening'

    ELSE 'Night'

  END AS time_of_day,

  SUM(unit_price * transaction_qty) AS hourly_sales

FROM bright_coffee_shop.coffee_shop.coffee_shop_sales

GROUP BY hour_bucket, time_of_day

ORDER BY hourly_sales DESC;

