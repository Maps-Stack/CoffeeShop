--date & time buckets
select transaction_date,
transaction_time
FROM bright_coffee_shop.coffee_shop.coffee_shop_sales;

--day bucket
SELECT 
  DATE_TRUNC('day', transaction_date) AS day_bucket,
  sum(unit_price*transaction_qty) AS daily_sales
FROM bright_coffee_shop.coffee_shop.coffee_shop_sales
GROUP BY day_bucket
ORDER BY day_bucket;

--week bucket
SELECT 
  DATE_TRUNC('week', transaction_date) AS week_bucket,
  sum(unit_price*transaction_qty) AS weekly_sales
FROM bright_coffee_shop.coffee_shop.coffee_shop_sales
GROUP BY week_bucket
ORDER BY week_bucket;

--monthly bucket
SELECT 
  DATE_TRUNC('month', transaction_date) AS month_bucket,
  sum(unit_price*transaction_qty) AS monthly_sales
FROM bright_coffee_shop.coffee_shop.coffee_shop_sales
GROUP BY month_bucket
ORDER BY month_bucket;

