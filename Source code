--CREATE OR REPLACE TABLE selling_product_phour AS
--most selling product on peak hour
SELECT
  product_category,
  EXTRACT(HOUR FROM transaction_time) AS peak_hour,
  SUM(transaction_qty * unit_price) AS total_sale
FROM bright_coffee_shop.coffee_shop.coffee_shop_sales
WHERE EXTRACT(HOUR FROM transaction_time) = 10
GROUP BY product_category, peak_hour
ORDER BY total_sale DESC;


